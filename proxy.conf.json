{
  "/api/v1/**": {
    "target": "http://127.0.0.1:8080",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "warn"
  },
  "/api/pagos/**": {
    "target": "http://127.0.0.1:8081",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "warn"
  },
  "/api/matriculas/**": {
    "target": "http://127.0.0.1:8082",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "warn"
  },
  "/api/indexer/**": {
    "target": "http://127.0.0.1:8084",
    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/indexer": "/actuator"
    },
    "logLevel": "warn"
  }
}
